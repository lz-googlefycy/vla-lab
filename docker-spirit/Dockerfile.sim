# ============================================================
# Spirit v1.5 + Maniskill / XLeRobot sim extension.
# Extends: spirit-v1.0-cu128-py310
# Adds:    mani_skill 3.0, sapien 3.0, XLeRobot agent registration
# Tag:     spirit-sim-v1.0-cu128-py310
# ============================================================

FROM spirit-v1.0-cu128-py310

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# ============================================================
# 1. Extra system deps for sapien (OpenGL, Vulkan for renderer)
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        libvulkan1 libvulkan-dev mesa-vulkan-drivers \
        libgl1 libglu1-mesa libglib2.0-0 \
        libxrandr2 libxinerama1 libxcursor1 libxi6 \
        x11-xserver-utils xauth \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 2. Maniskill + SAPIEN + deps
# ============================================================
RUN pip install \
        mani_skill==3.0.1 \
        sapien==3.0.3 \
        h5py==3.16.0 \
        matplotlib \
        imageio[ffmpeg] \
        opencv-python \
        lxml

# ============================================================
# 2b. LIBERO (for "Spirit sees a robot scene" Phase A demo)
#     Deps borrowed from openvla-v1.0's libero setup.
# ============================================================
RUN pip install \
        robosuite==1.4.1 \
        bddl \
        easydict \
        cloudpickle \
        gym \
        hydra-core
RUN cd /workspace && git clone https://github.com/Lifelong-Robot-Learning/LIBERO.git \
    && cd LIBERO && pip install -e . --no-deps

# libero has no __init__.py at top-level; force path inclusion
RUN echo '/workspace/LIBERO' > /opt/conda/lib/python3.11/site-packages/libero_local.pth

# Initialise LIBERO config non-interactively
RUN echo 'N' | /opt/conda/bin/python -c "import libero; from libero.libero import benchmark" || true

# ============================================================
# 3. Copy XLeRobot sim agent files (from this repo)
#    Caller mounts /home/ubuntu/XLeRobot/simulation at /workspace/XLeRobot_sim
# ============================================================

# Default env: render offscreen (no X server in container)
ENV DISPLAY=""
# mujoco.egl import chain fails in headless container without an EGL device;
# forcing osmesa avoids that (verified with mani_skill 3.0.1 + sapien 3.0.3)
ENV MUJOCO_GL=osmesa
ENV PYOPENGL_PLATFORM=osmesa
# Maniskill uses SAPIEN, which uses Vulkan — configure for headless
ENV SAPIEN_HEADLESS=1

# osmesa requires libosmesa6-dev at runtime (already pulled in in the base image's
# LIBERO deps, but we re-declare here for clarity).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libosmesa6 libosmesa6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/spirit-v1.5

CMD ["/bin/bash"]
