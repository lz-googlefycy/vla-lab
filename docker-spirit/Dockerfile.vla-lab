# ============================================================
# vla-lab-v1.0 — unified image for v1.5 post-training paper
# Base:  spirit-v1.1-cu128-py311
# Adds:  timm, peft, accelerate, bitsandbytes (OpenVLA family)
#        h5py, imageio[ffmpeg] (rollout video / data)
#
# JAX (for π0.5 path) is intentionally NOT installed here — it's a 2GB
# wheel that doubles build time. Install at runtime if needed:
#   pip install "jax[cuda12]==0.4.34" flax==0.10.0
#
# Goal: one image to cover OpenVLA + Spirit + Maniskill + LIBERO across
#       inference, training, and eval. ~ +500MB on top of spirit-v1.1.
#
# Build:
#   cd ro_planning/docker-spirit
#   docker build -f Dockerfile.vla-lab -t vla-lab-v1.0-cu128-py311 .
# ============================================================

FROM spirit-v1.1-cu128-py311

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# ============================================================
# 1. OpenVLA family deps
#    - timm: OpenVLA's vision encoder uses timm ViT
#    - peft: optional, in case we need official LoRA path later
#    - accelerate: required by transformers low_cpu_mem_usage
#    - bitsandbytes: optional 4-bit quantisation for tight VRAM budgets
# ============================================================
RUN pip install \
        timm==0.9.10 \
        "peft>=0.17.0" \
        accelerate==1.0.0 \
        bitsandbytes \
    || (echo "pip install partial failure — check logs"; exit 1)

# ============================================================
# 2. Eval / video / ffmpeg helpers
# ============================================================
RUN pip install \
        imageio[ffmpeg] \
        h5py \
    || true

# ============================================================
# 3. Sanity check at build time (no GPU needed for import)
# ============================================================
RUN python -c "\
import torch; \
import transformers; \
import timm; \
import peft; \
import accelerate; \
import diffusers; \
import mani_skill; \
import sapien; \
import libero; \
print(f'torch={torch.__version__}'); \
print(f'transformers={transformers.__version__}'); \
print(f'timm={timm.__version__}'); \
print(f'peft={peft.__version__}'); \
print(f'accelerate={accelerate.__version__}'); \
print(f'mani_skill={mani_skill.__version__}'); \
print(f'sapien={sapien.__version__}'); \
print('libero: ok')"

WORKDIR /workspace
CMD ["/bin/bash"]
